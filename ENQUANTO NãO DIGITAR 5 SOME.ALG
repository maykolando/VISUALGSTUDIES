Algoritmo "enquanto não digitar 5 some"
Var
numero, resultado: inteiro

Inicio



      enquanto numero <> 5 faca
      
      escreval ("Digite um número: ")
      leia (numero)
      escreval
      resultado <- resultado + numero

      fimenquanto
       escreval ("TOTAL: ",resultado)
       escreval
       escreval ("Você digitou o número 5!")

Fimalgoritmo