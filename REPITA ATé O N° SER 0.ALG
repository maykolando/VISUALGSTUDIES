Algoritmo "Repita até o N° ser 0"

Var
   numero, maior: inteiro

Inicio

          maior <- 0
      repita
       escreval ("Digite um número")
       leia (numero)

       se ( numero > maior) entao
       
       maior <- numero
       
       fimse

       ate numero = 0
       
       escreval ("O maior número é ", maior)

Fimalgoritmo